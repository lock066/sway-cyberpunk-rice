{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#7aa2f7",
          "foreground": "#1a1b26",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " \uf120 {{ .Name }} ",
          "type": "shell"
        },
        {
          "background": "#bb9af7",
          "foreground": "#1a1b26",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \uf0e7 {{ .UserName }} ",
          "type": "session"
        },
        {
          "background": "#7dcfff",
          "foreground": "#1a1b26",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \uf07b {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#9ece6a",
          "foreground": "#1a1b26",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ue725 {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus}} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#7dcfff",
          "style": "plain",
          "template": "\u276f ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 2
}
